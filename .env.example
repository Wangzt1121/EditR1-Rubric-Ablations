# Copy this file to .env and replace placeholders locally.
# Never commit .env or API keys.
GEMINI_API_KEY=
GEMINI_REWARD_MODEL=gemini-3.1-flash-lite

# Local model and Stage-I LE-LoRA used to initialize all three runs.
PRETRAINED_MODEL=/path/to/FLUX.1-Kontext-dev
LORA_PATH=/path/to/step-30000.safetensors
LORA_LEARNING_RATE=5e-4

# Dataset metadata. Images referenced by the JSONL files must be readable.
DATASET_ROOT=/path/to/dataset
PROMPT_METADATA_FILE=/path/to/train_metadata.jsonl
EVAL_PROMPT_METADATA_FILE=/path/to/test_metadata.jsonl

# Evaluate the same first 50 validation samples after steps 50, 100, and 150.
EVAL_FREQ=50
SKIP_EVAL=0
EVAL_SAMPLE_COUNT=50

# Runtime. NPROC_PER_NODE is inferred from CUDA_VISIBLE_DEVICES if omitted.
CUDA_VISIBLE_DEVICES=0,1,2,3
PYTHON_BIN=/path/to/conda/envs/Edit-R1/bin/python

# All experiment directories are created below this root.
OUTPUT_ROOT=/path/to/Edit-R1_rubric_ablation_release/outputs

# Optional proxy environment script for the official Gemini endpoint.
USE_PROXY=0
PROXY_ENV_FILE=
